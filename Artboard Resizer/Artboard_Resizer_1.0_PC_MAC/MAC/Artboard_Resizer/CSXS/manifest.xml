<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
    ExtensionBundleId="com.eduardonoe.artboardresizer"
    ExtensionBundleVersion="2.7.0"
    ExtensionBundleName="Artboard Resizer"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.eduardonoe.artboardresizer.panel" Version="2.7.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="ILST" Version="[23.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.eduardonoe.artboardresizer.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./host/ArtboardResizer.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-file-cookies</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Artboard Resizer</Menu>
                    <Geometry>
                        <Size>
                            <Width>340</Width>
                            <Height>690</Height>
                        </Size>
                        <MinSize>
                            <Width>290</Width>
                            <Height>550</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>900</Width>
                            <Height>1200</Height>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
